# Database connection (JDBC URL)
DB_URL=jdbc:mysql://localhost:3306/fincoach?useSSL=false&serverTimezone=UTC

# PostgreSQL example (use with prod-pg profile)
# DB_URL=jdbc:postgresql://localhost:5432/fincoach

# Database credentials
DB_USERNAME=root
DB_PASSWORD=your_password

# DeepSeek API key (required for AI chat)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Server port (optional, default 8080)
SERVER_PORT=8080
